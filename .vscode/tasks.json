{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lint books",
      "type": "shell",
      "command": "npm run lint:content",
      "group": "test",
      "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "smartbook",
        "source": "lint:content",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(books/.+?):(\\d+): (error|warning) ([a-z-]+): (.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        }
      }
    },
    {
      "label": "package book",
      "type": "shell",
      "command": "npm run package -- ${input:bookSlug}",
      "problemMatcher": []
    },
    {
      "label": "validate",
      "type": "shell",
      "command": "npm run validate",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "bookSlug",
      "type": "promptString",
      "description": "Book slug to package (or --all)"
    }
  ]
}
