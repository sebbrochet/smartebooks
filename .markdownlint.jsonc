{
  // Shared markdownlint rules, so the editor extension and any CLI run agree.
  //
  // Book content is Markdown first and directives second, so the ordinary rules
  // apply — a chapter that reads badly as plain Markdown has failed its own
  // charter. Two rules are adjusted rather than obeyed:
  "MD013": {
    // Prose targets Prettier's printWidth of 100. Directive lines cannot wrap:
    // the whole `{…}` attribute block must sit on one line, and a chess FEN is
    // 69 characters of it before anything else. Measured 2026-08-30: a
    // `chess-analysis` carrying a FEN, an id, a stated evaluation, a best move
    // and a depth is 146 characters. 120 was set before those attributes
    // existed and would now silently push authors into dropping content to
    // satisfy a linter, which is the wrong way round.
    "line_length": 160,
    "code_blocks": false,
    "tables": false,
  },

  // Headings inside a container directive are structural, not document
  // outline: `### question` inside `:::quiz` is a quiz item. Keeping MD024 on
  // would flag two chapters that legitimately ask a similarly-worded question.
  "MD024": { "siblings_only": true },

  // The first line of a chapter is its title, and `makeChapters` reads it.
  "MD041": true,
}
