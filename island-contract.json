      "best": { "type": "string" }
    },
    "chess-game": {
      "theme": { "type": "enum", "values": ["brown", "blue", "green", "grey"] },
      "pieces": { "type": "enum", "values": ["cburnett", "unicode"] },
      "orientation": { "type": "enum", "values": ["white", "black", "auto"] },
      "shapes": { "type": "boolean" },
      "pgn": { "type": "asset" }
    },
    "chess-moves": { "scroll": { "type": "boolean" } },
    "move": {},
    "term": { "definition": { "type": "string" } },
    "mermaid": {
